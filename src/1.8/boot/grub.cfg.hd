set timeout=3
set default=0
set timeout_style=menu
insmod all_video
set gfxmode=1024x768,800x600,auto
insmod gfxterm
insmod png
insmod gfxmenu
insmod font
loadfont /boot/grub/fonts/mapple.pf2
set theme=/boot/grub/theme/mapple/theme.txt
export theme
terminal_output gfxterm
insmod multiboot
search --file --set=root /boot/kernel.elf
menuentry "mapple 0.13.0 (HD)" {
  multiboot /boot/kernel.elf
  module /boot/initrd.cpio
  boot
}
menuentry "mapple (sem initramfs)" {
  multiboot /boot/kernel.elf
  boot
}
